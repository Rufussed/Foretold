PORT=3000
DB_PATH=./data/wizard.sqlite
JWT_SECRET=change-this-in-development
TOKEN_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Accounts allowed on the #/admin page, comma separated.
ADMIN_USERNAMES=Rufus
# Minutes a guest table may sit without a move before it and its guest are deleted.
GUEST_IDLE_MINUTES=30
# Seconds a guest may be disconnected from their game before it and they are deleted.
GUEST_DISCONNECT_SECONDS=120
