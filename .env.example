PORT=3000
DB_PATH=./data/wizard.sqlite
JWT_SECRET=change-this-in-development
TOKEN_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Accounts allowed on the #/admin page, comma separated.
ADMIN_USERNAMES=Rufus
# Minutes a guest table may sit without a move before it and its guest are deleted.
GUEST_IDLE_MINUTES=30
# Seconds a guest may be disconnected from their game before it and they are deleted.
GUEST_DISCONNECT_SECONDS=120
# Mail: the confirmation and new-password links (backend/src/services/mailService.ts).
# Without SMTP_HOST no mail is sent; each one is printed in the backend console.
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# SMTP_USER=noreply@foretold.live
# SMTP_PASS=
# MAIL_FROM=Wizard Foretold <noreply@foretold.live>
# Where the links in a mail lead.
# APP_URL=https://foretold.live
